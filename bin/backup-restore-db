#!/bin/bash
set -e

# Usage:  bin/backup-restore-db backup
# Usage:  bin/backup-restore-db restore file_name

export RAILS_ENV=development
export PGUSER=discourse
export USER=discourse
export PG_DUMP_USERNAME=discourse

CMD=$1

case "$CMD" in
  backup)
    echo "Running backup..."
    RAILS_ENV=development bundle exec script/discourse backup
    echo "Backup done. Files are in public/backups/default/"
    ;;
  restore)
    FILE=$2
    if [ -z "$FILE" ]; then
      echo "Please provide restore file_path (e.g. /workspace/discourse/public/backups/default//2025-07-24-072306.tar.gz)"
      exit 1
    fi
    echo "Restoring from backup: $FILE"
    RAILS_ENV=development bundle exec script/discourse restore "$FILE"
    ;;
  *)
    echo "Usage: $0 {backup|restore <file>}"
    exit 1
    ;;
esac

